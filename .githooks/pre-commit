#!/bin/sh
# Pre-commit checks for sbmadhav.com. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify
#
# 1. Regenerate stamped and generated files; fail if that changed anything,
#    so the regenerated files get staged with the commit.
# 2. Home page colors must match the pinned design tokens (scripts/design-tokens.json).
# 3. Vedic Math unit tests, when they exist.

cd "$(git rev-parse --show-toplevel)" || exit 1

fail() {
  printf '\npre-commit: %s\n' "$1" >&2
  exit 1
}

# Fingerprint of unstaged changes before and after the builds
before=$(git diff --binary --no-ext-diff | git hash-object --stdin)

python3 site-build.py >/dev/null || fail "site-build.py failed"

after=$(git diff --binary --no-ext-diff | git hash-object --stdin)
if [ "$before" != "$after" ]; then
  git diff --stat >&2
  fail "the builds regenerated files (listed above). Review them, git add them, and commit again."
fi

python3 scripts/check-tokens.py || fail "index.html colors disagree with scripts/design-tokens.json"

if [ -d vedic-math/test ]; then
  command -v node >/dev/null 2>&1 || fail "node is required to run vedic-math/test"
  node --test --test-reporter=dot 'vedic-math/test/**/*.test.{js,mjs}' >&2 || fail "vedic-math tests failed"
fi

exit 0
